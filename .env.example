# CORS
FRONTEND_URL=http://127.0.0.1:8000
ENVIRONMENT=development

# Neon postgresql
DATABASE_URI=

# JWT token secrets
# To generate JWT_SECRET_KEY -> python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGRORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Reset password token expire time in minutes
# Here 60 minutes to expire a reset password token
RESET_TOKEN_EXPIRE_MINUTES=60

# Mail configurations
# Dev configs with mailtrap
MAIL_SERVER=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true

# Storage config imagekit
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
